// ===== Types & State Machine (ChatGPT Improvement #1) =====

export type PlayerState =
    | 'idle'
    | 'waiting'
    | 'playing'
    | 'preloading'
    | 'switching'
    | 'ended'
    | 'error';

export interface ChunkInfo {
    index: number;
