                    case 'connected':
                        el.className = 'absolute top-4 ' + (isRTL ? 'left-4' : 'right-4') + ' px-3 py-1 rounded-full text-sm bg-green-600 text-white';
                        el.innerHTML = '<i class="fas fa-check mr-2"></i>Connected';
