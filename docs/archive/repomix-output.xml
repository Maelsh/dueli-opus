master_sql = "-- Master Schema (Remote + Missing from Code)\n"
for m in matches:
    master_sql += m.group(0) + "\n\n"

master_sql += missing_tables

with codecs.open('migrations/0001_master_schema.sql', 'w', encoding='utf-8') as f:
    f.write(master_sql)
</file>

