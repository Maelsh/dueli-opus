  font-style: italic;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
}
.join-btn {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  color: white;
  padding: 10px 24px;
  border-radius: 24px;
  font-weight: 700;
  border: none;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}
.join-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);
}
input, textarea, select {
  transition: all 0.2s ease;
}
input:focus, textarea:focus, select:focus {
  outline: none;
  border-color: #8B5CF6 !important;
  box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.1);
}
.user-menu {
  position: absolute;
  top: 100%;
  margin-top: 8px;
  width: 220px;
  background: white;
  border-radius: 16px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
  border: 1px solid #e5e7eb;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: all 0.2s ease;
}
body.dark .user-menu {
  background: #1f1f1f;
  border-color: #374151;
}
.user-menu.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}
.user-menu-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  transition: background 0.2s ease;
  cursor: pointer;
}
.user-menu-item:hover {
  background: #f3f4f6;
}
body.dark .user-menu-item:hover {
  background: #2d2d2d;
}
.toast {
  position: fixed;
  bottom: 24px;
  padding: 14px 24px;
  border-radius: 12px;
  font-weight: 500;
  z-index: 200;
  animation: slide-in 0.3s ease;
}
.toast-success {
  background: #10B981;
  color: white;
}
.toast-error {
  background: #EF4444;
  color: white;
}
.toast-info {
  background: #3B82F6;
  color: white;
}
[dir="rtl"] .toast {
  left: 24px;
  right: auto;
}
[dir="ltr"] .toast {
  right: 24px;
  left: auto;
}
@media (max-width: 640px) {
  .duel-card {
    width: 260px;
