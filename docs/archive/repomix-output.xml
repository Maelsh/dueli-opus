    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
}

.section-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(139, 92, 246, 0.1);
    color: #8B5CF6;
}

body.dark .section-icon {
    background: rgba(139, 92, 246, 0.2);
}

