        const rtl = isRTL(lang);
        const dir = rtl ? 'rtl' : 'ltr';
        const align = rtl ? 'right' : 'left';
        const logoUrl = 'https://project-8e7c178d.pages.dev/static/dueli-icon.png';

        return `
