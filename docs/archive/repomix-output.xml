.nav-icon:hover {
  background: rgba(139, 92, 246, 0.1);
}
body.dark .nav-icon:hover {
  background: rgba(139, 92, 246, 0.2);
}
.section-header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
.section-icon {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(139, 92, 246, 0.1);
  color: #8B5CF6;
}
body.dark .section-icon {
  background: rgba(139, 92, 246, 0.2);
}
.duel-card {
  width: 280px;
  flex-shrink: 0;
  cursor: pointer;
  transition: all 0.3s ease;
}
.duel-card:hover {
  transform: translateY(-4px);
}
.duel-card:hover .duel-thumbnail {
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.2);
}
.duel-thumbnail {
  aspect-ratio: 16/9;
  border-radius: 16px;
  overflow: hidden;
  position: relative;
  transition: all 0.3s ease;
}
.competitor-avatar {
  width: 75px;
  height: 75px;
  border-radius: 50%;
