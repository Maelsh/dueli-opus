                        liveSyncDuration: 3,
                        liveMaxLatencyDuration: 10
                    });
                    hls.loadSource(hlsUrl);
                    hls.attachMedia(hlsPlayer);
                    hls.on(Hls.Events.MANIFEST_PARSED, () => {
                        hlsPlayer.play().catch(e => console.log('Autoplay blocked'));
