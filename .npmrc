# Dueli: @cloudflare/vitest-pool-workers@0.22 still peers on vitest ^4 while the
# repo uses vitest ^5 (workers pool unused — tests run on the node/forks pool).
# legacy-peer-deps keeps installs working until Cloudflare ships a vitest-5
# compatible pool. See docs/12-SECURITY-REMEDIATION.md SEC-15.
legacy-peer-deps=true
